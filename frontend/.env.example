# GenLayer RPC API URL
# The v2 prerelease targets canonical GenLayer Studio-dev (Consensus v0.6).
# Override all network values together when using another GenLayer deployment.
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-dev.genlayer.com/api

# GenLayer Network Configuration
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio-dev
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# Canonical Uphold V1.2 contract on Studio-dev.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5C2C0827B08C720787673dE325a36886e8Ec8645
